<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Açılış (splash), Android 12+ sistem splash API'si: yalnızca ikon gösterilebilir (logo işareti). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/brand_black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/brand_black</item>
    </style>
</resources>
